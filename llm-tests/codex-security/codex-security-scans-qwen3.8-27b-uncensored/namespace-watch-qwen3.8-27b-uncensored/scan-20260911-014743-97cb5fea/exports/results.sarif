            "confidence": "high",
            "findingId": "csf_16d06923985f6a1e9868f6b1",
            "occurrenceId": "occ_72abd6def7fe64e96145eb9f",
            "severity": "low"
          },
          "ruleId": "insecure-design.networkpolicy-label-gate",
          "ruleIndex": 3
        },
        {
          "level": "note",
          "locations": [
