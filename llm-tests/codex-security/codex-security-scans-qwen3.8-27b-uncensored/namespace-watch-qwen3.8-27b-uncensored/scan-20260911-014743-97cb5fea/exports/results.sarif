            "confidence": "medium",
            "findingId": "csf_70b5e1de4726af419a3bc512",
            "occurrenceId": "occ_d1ba70419ad3661340103751",
            "severity": "medium"
          },
          "ruleId": "insecure-design.default-name-spoofing",
          "ruleIndex": 1
