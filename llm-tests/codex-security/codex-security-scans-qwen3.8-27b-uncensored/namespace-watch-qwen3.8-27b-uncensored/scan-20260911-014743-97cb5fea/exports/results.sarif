                  "uri": "internal/watcher/watcher.go"
                },
                "region": {
                  "endLine": 26,
                  "startLine": 26
                }
              }
            },
            {
              "message": {
                "text": "evidence:already-exists-skip"
              },
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "internal/provisioner/provisioner.go"
                },
                "region": {
                  "endLine": 119,
                  "startLine": 110
                }
              }
            },
            {
              "message": {
                "text": "evidence:fixed-names"
              },
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "internal/config/config.go"
                },
                "region": {
                  "endLine": 114,
                  "startLine": 106
                }
              }
            }
          ],
          "message": {
            "text": "The watcher creates six resources with fixed names (production-quota, default-limits, myapp-sa, myapp-role, myapp-rolebinding, myapp-network-policy) and treats an AlreadyExists create error as success without verifying the pre-existing object is the one it would have created. The `app.kubernetes.io/managed-by` label is stamped onto the templates but never checked against existing objects. A namespace creator who also has create permission on the target resource type inside their namespace can race the watcher: create the namespace, then immediately create a permissive `production-quota` (or a lenient `myapp-network-policy`). The watcher's create returns 409, is treated as success, and the namespace is recorded done with the attacker's object as the effective default. The attacker can widen the race window arbitrarily by congesting the 1024-entry enqueue channel with other namespace creations."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:d19e14df95333915b0b8ffd410d9e973460b7279674b18304577c2771ab123e4",
            "primaryLocationLineHash": "b6b6f9d578573108:1"
          },
