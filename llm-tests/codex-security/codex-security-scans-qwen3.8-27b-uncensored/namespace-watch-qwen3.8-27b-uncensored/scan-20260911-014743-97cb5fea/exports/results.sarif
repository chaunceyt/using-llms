                  "uri": "deploy/namespace-watcher.yaml"
                },
                "region": {
                  "endLine": 90,
                  "startLine": 87
                }
              }
            },
            {
              "message": {
                "text": "evidence:prov-done-mark"
              },
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "internal/provisioner/provisioner.go"
                },
                "region": {
                  "endLine": 61,
                  "startLine": 53
                }
              }
            },
            {
              "message": {
                "text": "evidence:onadd-isdone-skip"
              },
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "internal/watcher/watcher.go"
                },
                "region": {
                  "endLine": 186,
                  "startLine": 176
                }
              }
            }
          ],
          "message": {
            "text": "The watcher keys its provisioning state in an in-memory `done` map by namespace name and never clears it; no namespace delete handler is registered and no reconciliation exists. `onAdd` short-circuits when `provisioner.IsDone(name)` is true, so a namespace that was provisioned once, then deleted and recreated with the same name, is skipped for the watcher's entire lifetime. Its ResourceQuota, LimitRange, and NetworkPolicy were garbage-collected with the deleted namespace, leaving the recreation without any of the cluster's per-tenant containment defaults. With the deployed default (no `--backfill` in deploy/namespace-watcher.yaml), the escape also survives a process restart because the recreated namespace is captured into the `known` set at startup and treated as pre-existing."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:4a2f133dca21939a2c1da4a5b8a8a21880941756e51a59d85a15b28d8b0354ba",
            "primaryLocationLineHash": "c41a8161905e718e:1"
          },
          "properties": {
            "category": "insecure_design",
            "confidence": "high",
            "findingId": "csf_2d93adc68011c5ce8a7bcaff",
            "occurrenceId": "occ_cf97be19fa778e7c20c149cd",
            "severity": "high"
          },
          "ruleId": "insecure-design.namespace-recreate-escape",
          "ruleIndex": 2
        },
        {
          "level": "warning",
          "locations": [
