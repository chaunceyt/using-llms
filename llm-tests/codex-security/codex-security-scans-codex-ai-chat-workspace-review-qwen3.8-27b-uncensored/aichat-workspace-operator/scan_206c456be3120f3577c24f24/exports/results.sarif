            "confidence": "high",
            "findingId": "csf_56e445ebfd31087438d8b511",
            "occurrenceId": "occ_b37139740f5567f414607f34",
            "severity": "medium"
          },
          "ruleId": "exposure.openwebui-public-cleartext",
          "ruleIndex": 1
        }
      ],
