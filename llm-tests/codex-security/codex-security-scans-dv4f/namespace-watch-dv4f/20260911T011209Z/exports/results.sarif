            {
              "message": {
                "text": "evidence:default-binding"
              },
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "internal/resources/rbac.go"
                },
                "region": {
                  "endLine": 87,
                  "startLine": 66
                }
              }
            }
          ],
          "message": {
            "text": "The registry unconditionally provisions into every new namespace a fixed ServiceAccount `myapp-sa`, a Role granting `get`/`list` on the core `configmaps` resource across the whole namespace, and a RoleBinding binding them. Any workload that runs with this default SA can read all ConfigMaps in the namespace, including ones holding sensitive values."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:6d568c7615bf4eea66ce46d77861d2e2d5473cab6a764545f086d71a2faf6509",
