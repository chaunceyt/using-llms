            "findingId": "csf_464c2ccb6fbf6dcce48ea9ad",
            "occurrenceId": "occ_0b0f6a1e6039882296a31d35",
            "severity": "low"
          },
          "ruleId": "access-control.broad-dns-egress",
          "ruleIndex": 0
