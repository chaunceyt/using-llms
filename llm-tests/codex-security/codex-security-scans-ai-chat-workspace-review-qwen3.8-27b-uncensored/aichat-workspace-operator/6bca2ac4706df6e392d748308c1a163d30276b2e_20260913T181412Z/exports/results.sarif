          ],
          "message": {
            "text": "AIChatWorkspace CRs are namespaced, but `spec.workspaceName` maps to a cluster-scoped namespace and a public ingress hostname with no uniqueness enforcement. Two tenants that choose the same workspaceName target the same namespace: the first reconcile wins the workload names, and the Open WebUI it serves \u2014 deployed with no authentication at `<name>.<DefaultDomain>` \u2014 becomes reachable by the second tenant (and anyone who knows the name), disclosing the first tenant's chat history, uploaded documents, and Ollama model configuration."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:45d13d30a2466140ce49f47ccf85dfbb55371e70c1c1a97c0ed9c80aa152bf4f",
            "primaryLocationLineHash": "e8abce60602a7e80:1"
          },
          "properties": {
            "category": "Access Control",
            "confidence": "medium",
            "findingId": "csf_91c7f36582951c36a58ba132",
            "occurrenceId": "occ_15d436d6cb3864da0c7b8fc4",
            "severity": "medium"
          },
          "ruleId": "access-control.workspace-name-collision",
          "ruleIndex": 0
        },
