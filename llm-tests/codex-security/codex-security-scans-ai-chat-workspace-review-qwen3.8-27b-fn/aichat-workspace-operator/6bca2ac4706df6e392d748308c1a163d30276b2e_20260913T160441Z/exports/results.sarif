          "message": {
            "text": "The Makefile helm target pipes curl -s https://get.helm.sh/... | tar into LOCALBIN and executes it without checksum or signature verification; helmify is installed unpinned (@latest, with the target duplicated); .devcontainer/post-install.sh downloads 'latest' kind and kubebuilder and a kubectl binary with no checksum. A substituted download yields code execution on maintainer machines feeding the release pipeline."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:2bcefccfd362725a3b2979f418bcf88b22ff0fbe389ac6c4139a69be15f1b827",
