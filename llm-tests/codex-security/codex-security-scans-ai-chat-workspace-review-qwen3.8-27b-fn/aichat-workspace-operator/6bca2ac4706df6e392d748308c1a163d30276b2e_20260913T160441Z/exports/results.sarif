            }
          ],
          "message": {
            "text": "Generated from the controller markers, manager-role grants wildcard verbs over namespaces, pods, pods/exec, PVCs, services, service accounts, resource quotas, deployments, statefulsets, ingresses and httpscaledobjects, bound via ClusterRoleBinding. The reconciler never needs exec outside its own workspace pods (only du -sh on constant paths), so any input-driven flaw (as in the workspaceName finding) or manager-pod compromise escalates to pod creation and exec across kube-system and every tenant."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:f7b110086f24d0ccd67977ed282218807567128208743b4e13c9478de6f9beef",
            "primaryLocationLineHash": "145018ed64e6e8b2:1"
          },
          "properties": {
            "category": "privilege-management",
            "confidence": "high",
            "findingId": "csf_b8f00747e1a47b3666203a30",
            "occurrenceId": "occ_d3a5283e670d4f83eb725639",
            "severity": "medium"
          },
          "ruleId": "overbroad-operator-cluster-rbac",
          "ruleIndex": 7
        },
