              }
            }
          ],
          "message": {
            "text": "spec.Models flows into ollama.PullModel, which uses context.Background() and http.DefaultClient with no timeout and blocks until the pull finishes. The controller runs with the default single worker (no MaxConcurrentReconciles), so a single attacker-chosen multi-GB or stalled model reference blocks status updates, workload creation, and deletion finalization for all other AIChatWorkspace objects."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:fe86a4b6d4c6c714fe7fff0caf20eaa000ac27259a931581667ecf363bf0e952",
            "primaryLocationLineHash": "99a547f527f51e87:1"
          },
