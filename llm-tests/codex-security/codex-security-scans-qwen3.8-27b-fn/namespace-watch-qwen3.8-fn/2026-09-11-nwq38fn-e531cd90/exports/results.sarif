            "confidence": "medium",
            "findingId": "csf_176a506e058f134e85cc1f51",
            "occurrenceId": "occ_7b0e17712d1596e1c195eee9",
            "severity": "low"
          },
          "ruleId": "controller-ownerref-delete-recreate-race-drops-defaults",
          "ruleIndex": 2
